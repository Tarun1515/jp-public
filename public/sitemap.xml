<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static, and hand-maintained on purpose: there are seven URLs and they change
  about once a phase. Generating it would be more machinery than the problem
  needs.

  ⚠️ Two things to keep in step:
    1. The host below must match `siteUrl` in environment.production.ts.
    2. Add a URL here whenever a route is added to app.routes.ts.

  /continue is deliberately absent — it is a routing step with no content of
  its own, and robots.txt disallows it.

  Job search and job detail pages arrive in Phase 4 and will need adding.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://staffroom.in/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://staffroom.in/how-it-works</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://staffroom.in/about</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://staffroom.in/faq</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://staffroom.in/contact</loc>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://staffroom.in/terms</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://staffroom.in/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
