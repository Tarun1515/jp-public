{
  "name": "jp-public",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "node scripts/serve.mjs",
    "build": "ng build --configuration development",
    "build:prod": "ng build",
    "link:shared": "npm --prefix ../jp-shared run link && npm link @tarun1515/jp-shared",
    "unlink:shared": "npm unlink @tarun1515/jp-shared && npm install",
    "update:shared": "npm install @tarun1515/jp-shared@latest",
    "shared-version": "node -p \"require('@tarun1515/jp-shared/package.json').version\""
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "@tarun1515/jp-shared": "^1.0.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tarun1515/jp-public.git"
  }
}
